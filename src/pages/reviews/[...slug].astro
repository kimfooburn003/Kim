---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CoverImage from '../../components/CoverImage.astro';
//import NewsletterForm from '../../components/NewsletterForm.astro';
import ReviewCoverCard from '../../components/ReviewCoverCard.astro';
import { getSimilarReviews } from '../../lib/content';
import {
  BOOK_TAG,
  BOOK_TAGS,
  DEFAULT_FORMAT_TAG,
  DEFAULT_STATUS_TAG,
  FORMAT_TAGS,
  PROGRESSION_TAGS,
  PROTAGONIST_TAGS,
  SOURCE_TAGS,
  STATUS_TAGS,
  isSquareReviewTag,
  sortReviewTags,
  //type SourceTag,
} from '../../lib/review-tags';
import { formatWordCount } from '../../lib/wordcount';
import { withBase } from '../../config';

export async function getStaticPaths() {
  const entries = await getCollection('reviews');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry, allEntries: entries } }));
}

const { entry, allEntries } = Astro.props;
const { Content } = await render(entry);
const r = entry.data.review;

const ogImage = `/og/${entry.id}.webp`;
const ogDescription =
  r === 'π'
    ? "A review of my own novel — judge accordingly"
    : entry.data.description;

const RATING_TEXT = {
  'π': 'My stuff. I hope you like it.',
  S: 'So good, has a home in my head and my heart :)',
  A: 'Amazing, definitely recommended!',
  B: 'Great read, might be more niche.',
  C: 'Decent read.',
  D: 'Tried but not for me.',
  E: 'Disappointed.',
  F: 'Argh, was so excited to find a new amazing read.',
  G: 'Waiting to start once more chapters get written.',
} as const;
const ratingText = RATING_TEXT[r];

const titleCase = (s: string) => s.replaceAll('_', ' ').replace(/\b\w/g, (c) => c.toUpperCase());
const compactControlSize = 'text-sm sm:text-xs font-medium'  ;

const similarReviews = getSimilarReviews(entry, allEntries, 4);
const hasBookTag = entry.data.tags.some((tag) => BOOK_TAGS.includes(tag as (typeof BOOK_TAGS)[number]));
const hasStatusTag = entry.data.tags.some((tag) => STATUS_TAGS.includes(tag as (typeof STATUS_TAGS)[number]));
const hasFormatTag = entry.data.tags.some((tag) => FORMAT_TAGS.includes(tag as (typeof FORMAT_TAGS)[number]));
const yearTag = String(entry.data.date.getFullYear());

const reviewTags = sortReviewTags([
  ...entry.data.tags,
  ...(!hasBookTag ? [BOOK_TAG] : []),
  ...(!hasStatusTag ? [DEFAULT_STATUS_TAG] : []),
  ...(!hasFormatTag ? [DEFAULT_FORMAT_TAG] : []),
  yearTag,
]);

const reviewIndexUrl = new URL(withBase('/reviews/'), Astro.site!);
const filterUrlForTag = (tag: string, resetFilters = true) => {
  const params = resetFilters
    ? new URLSearchParams()
    : new URLSearchParams({
    book: 'series',
    source: SOURCE_TAGS.join('_'),
    format: 'novel_webnovel',
    include: 'litrpg',
  });
  const addTag = (key: string) => {
    const values = new Set((params.get(key) ?? '').split('_').filter(Boolean));
    values.add(tag);
    params.set(key, [...values].join('_'));
  };

  if (BOOK_TAGS.some((value) => value === tag)) params.set('book', tag);
  else if (STATUS_TAGS.some((value) => value === tag)) params.set('status', tag);
  else if (SOURCE_TAGS.some((value) => value === tag)) addTag('source');
  else if (FORMAT_TAGS.some((value) => value === tag)) addTag('format');
  else if (/^\d{4}$/.test(tag)) addTag('year');
  else if (PROGRESSION_TAGS.some((value) => value === tag)) addTag('progression');
  else if (PROTAGONIST_TAGS.some((value) => value === tag)) addTag('protagonist');
  else addTag('include');

  reviewIndexUrl.search = params.toString();
  return reviewIndexUrl.toString();
};

const specialTags = [
  ...BOOK_TAGS,
  ...STATUS_TAGS,
  ...SOURCE_TAGS,
  ...FORMAT_TAGS,
  ...PROGRESSION_TAGS,
  ...PROTAGONIST_TAGS,
];
const allTags = [
  ...new Set(
    allEntries
      .flatMap((review) => review.data.tags)
      .filter((tag) => !specialTags.includes(tag as (typeof specialTags)[number]) && !/^\d{4}$/.test(tag)),
  ),
].sort();
const tagColorClasses: Record<string, string> = {};
const assignTagColors = (tags: readonly string[]) => {
  tags.forEach((tag, index) => {
    tagColorClasses[tag] = index % 2 === 0 ? 'review-tag-dark' : 'review-tag-light';
  });
};
assignTagColors(allTags);
const knownTags = new Set(allEntries.flatMap((review) => review.data.tags));
assignTagColors(PROGRESSION_TAGS.filter((tag) => knownTags.has(tag)));
assignTagColors(PROTAGONIST_TAGS.filter((tag) => knownTags.has(tag)));

// Reddit-ready markdown for the `c` shortcut, built server-side so the page
// ships one string rather than the formatting logic. `entry.body` is the raw
// markdown source, matching what the Hugo template pasted in via `.RawContent`.
const abslink = new URL(`/reviews/${entry.id}/`, Astro.site!).toString();
const linkList = [
  `[review](${abslink})`,
  ...Object.entries(entry.data.links).map(([name, link]) => `[${name}](${link})`),
].join(', ');
const reviewMarkdown =
  `# **${entry.data.name}**\n\n` +
  `**Author:** ${entry.data.auth}\n\n` +
  `**Links:** ${linkList}\n\n` +
  `**Summary:** ${entry.data.description}\n\n` +
  `**Hook:** ${entry.data.sentence}\n\n*********\n` +
  (entry.body ?? '');
---
<BaseLayout title={entry.data.name} description={ogDescription} image={ogImage} type="article">
  <div class="content content blog-post relative">
    <div class="section-header blog">
      <h1 class={`title rating rating-${r} text-center`}>{entry.data.name}</h1>
    </div>
    <div class="max-w-4xl mx-auto mt-4 mb-16">
      <article class={`w-full review-summary bg-green-800 rounded-xl review-${r}`}>
        <div class="bg2 rounded-xl">
          <div class="bg-inner flex flex-col md:flex-row bg-green-800 rounded-xl overflow-hidden">
            <CoverImage
              entry={entry}
              width={500}
              height={800}
              class="rounded-l-xl block flex-none"
            />
            <div class="flex flex-col justify-between p-4 sm:p-8 text-center md:text-left">
              <div class="rating">
                <p class={`larger rating-${r}`}>{ratingText}</p>
              </div>
              <p class="text-lg text-green-400">{entry.data.description}</p>
              <ul class="review-card-tags flex flex-col gap-2 text-xs font-medium justify-center md:justify-start">
                <li class="w-full">
                  <ul class="flex flex-wrap gap-2">
                    {reviewTags.filter((tag) => !isSquareReviewTag(tag)).map((tag) => (
                      <li class={`inline-flex text-center rounded-full ${tagColorClasses[tag] ?? ''} tag-${tag}`}>
                        <a class="review-tag-link no-under" href={filterUrlForTag(tag)}>
                          {tag === 'royal-road' ? 'royal road' : tag}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
                <li class="w-full">
                  <ul class="flex flex-wrap gap-2">
                    {reviewTags.filter(isSquareReviewTag).map((tag) => (
                      <li class={`square-review-tag inline-flex text-center rounded ${tagColorClasses[tag] ?? ''} tag-${tag}`}>
                        <a class="review-tag-link no-under" href={filterUrlForTag(tag)}>
                          {tag}
                        </a>
                      </li>
                    ))}
                    {entry.data.serieswordcount != null && (
                      <li class="square-review-tag tag-wordcount inline-flex text-center rounded">
                        {formatWordCount(entry.data.serieswordcount)} words
                      </li>
                    )}
                  </ul>
                </li>
              </ul>
              <div class="text-base flex flex-wrap justify-center md:justify-start">
                {Object.entries(entry.data.links).map(([name, link]) => (
                  <a
                    class={`no-under btn-xs ${compactControlSize} text-white bg-${r}-700 hover:bg-${r}-600 mt-2 mr-2`}
                    href={link}
                  >
                    <span>{titleCase(name)}</span>
                    <svg
                      class="w-3 h-3 fill-current shrink-0 ml-2"
                      viewBox="0 0 12 12"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path d="M6 5H0v2h6v4l6-5-6-5z" />
                    </svg>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>
    <div class="max-w-xl2 mx-auto review-article"><Content /></div>
    <div class="mt-20">
      <p class="text-center"><a href={withBase('/reviews/')}>Return to review index.</a></p>
    </div>
    {similarReviews.length > 0 && (
      <div class="mt-20">
        <h2 class="text-2xl font-bold text-center mb-8">Books with similar tags:</h2>
        <p class="text-center">(It's literally just tag overlap, nothing that works very well.)</p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-4xl mx-auto">
          {similarReviews.map((similar) => (
            <ReviewCoverCard entry={similar} />
          ))}
        </div>
      </div>
    )}
    <!-- <div class="mt-20"><NewsletterForm /></div> -->
  </div>
  <script is:inline define:vars={{ reviewMarkdown }}>
    document.addEventListener('keypress', (event) => {
      if (event.ctrlKey || event.metaKey || event.altKey) return;
      const target = event.target;
      if (
        target instanceof HTMLElement &&
        (target.tagName === 'INPUT' ||
          target.tagName === 'TEXTAREA' ||
          target.isContentEditable)
      ) {
        return;
      }
      if (event.key !== 'c' && event.key !== 'C') return;
      navigator.clipboard
        ?.writeText(reviewMarkdown)
        .catch((err) => console.error('Could not copy review markdown:', err));
    });
  </script>
</BaseLayout>
